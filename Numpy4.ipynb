       "array([[nan,  2.,  3.],\n",
       "       [ 4.,  6.,  7.],\n",
       "       [ 5., nan,  0.],\n",
       "       [48., 63., nan]])"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import numpy as np \n",
    "arr = np.array([[np.nan,2,3],[4,6,7],[5,np.nan,0],[48,63,np.nan]])\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "0f1536b4",
   "metadata": {},
   "outputs": [
    {
     "data": {
